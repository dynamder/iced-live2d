# mocari 0.4.1 uploads textures without a mip chain, so thin line art
# breaks up into dashed speckles whenever the model is drawn smaller than its
# atlas.
#
# Cubism atlases are authored at 4096-8192 px while a desktop pet draws the model
# at a few hundred pixels, i.e. 4-8x minification. With mip_level_count = 1 the
# GPU can only take one bilinear tap per fragment, so a 1 px line hits some
# fragments and misses its neighbours. The official Cubism Viewer enables
# mipmaps by default and the same region renders smoothly there.
#
# Fix: build the mip chain on the CPU during upload and filter across levels.
# Costs +33% VRAM and ~0.5 s of startup for a rig this size; measured on the
# DeepSeek rig the finger line art goes from dotted to continuous.
#
# Apply with: powershell -File scripts/vendor-mocari.ps1

--- a/src/render/wgpu/pipeline.rs
+++ b/src/render/wgpu/pipeline.rs
@@ -175,7 +175,7 @@ impl WgpuLive2dRenderer {
             address_mode_w: wgpu::AddressMode::ClampToEdge,
             mag_filter: wgpu::FilterMode::Linear,
             min_filter: wgpu::FilterMode::Linear,
-            mipmap_filter: wgpu::MipmapFilterMode::Nearest,
+            mipmap_filter: wgpu::MipmapFilterMode::Linear,
             ..Default::default()
         });
         let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
@@ -519,6 +519,11 @@ impl WgpuLive2dRenderer {
             });
         }
 
+        // Cubism atlases are huge compared to the on-screen size of the model, so
+        // the renderer minifies them heavily. Without a mip chain a single
+        // bilinear tap misses thin line art and it breaks up into dashed
+        // speckles. Build the chain on the CPU and let the sampler pick levels.
+        let mip_levels = mip_level_count(width, height);
         let size = wgpu::Extent3d {
             width,
             height,
@@ -527,23 +532,49 @@ impl WgpuLive2dRenderer {
         let texture = device.create_texture(&wgpu::TextureDescriptor {
             label: Some("live2d.texture.rgba8"),
             size,
-            mip_level_count: 1,
+            mip_level_count: mip_levels,
             sample_count: 1,
             dimension: wgpu::TextureDimension::D2,
             format: wgpu::TextureFormat::Rgba8Unorm,
             usage: wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
             view_formats: &[],
         });
-        queue.write_texture(
-            texture.as_image_copy(),
-            rgba,
-            wgpu::TexelCopyBufferLayout {
-                offset: 0,
-                bytes_per_row: Some(width * 4),
-                rows_per_image: Some(height),
-            },
-            size,
-        );
+
+        let mut level_width = width;
+        let mut level_height = height;
+        let mut level_data = rgba.to_vec();
+
+        for level in 0..mip_levels {
+            let level_size = wgpu::Extent3d {
+                width: level_width,
+                height: level_height,
+                depth_or_array_layers: 1,
+            };
+
+            queue.write_texture(
+                wgpu::TexelCopyTextureInfo {
+                    texture: &texture,
+                    mip_level: level,
+                    origin: wgpu::Origin3d::ZERO,
+                    aspect: wgpu::TextureAspect::All,
+                },
+                &level_data,
+                wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(level_width * 4),
+                    rows_per_image: Some(level_height),
+                },
+                level_size,
+            );
+
+            if level + 1 < mip_levels {
+                let (next_width, next_height, next_data) =
+                    downsample_rgba(level_width, level_height, &level_data);
+                level_width = next_width;
+                level_height = next_height;
+                level_data = next_data;
+            }
+        }
 
         let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
         let bind_group = self.create_texture_bind_group(device, &view);
@@ -671,3 +702,53 @@ fn create_textured_triangle_pipeline(
         cache: None,
     })
 }
+
+/// Number of mip levels for a full chain down to 1x1, capped at 13 levels.
+fn mip_level_count(width: u32, height: u32) -> u32 {
+    let longest = width.max(height).max(1);
+    1 + longest.ilog2().min(12)
+}
+
+/// Box-filter downscale by 2, averaging in premultiplied space so texels next to
+/// fully transparent ones do not pick up dark halos.
+fn downsample_rgba(width: u32, height: u32, rgba: &[u8]) -> (u32, u32, Vec<u8>) {
+    let next_width = (width / 2).max(1);
+    let next_height = (height / 2).max(1);
+    let mut out = vec![0u8; (next_width * next_height * 4) as usize];
+
+    for y in 0..next_height {
+        for x in 0..next_width {
+            let mut acc = [0.0_f32; 4];
+            let mut samples = 0.0_f32;
+
+            for dy in 0..2u32 {
+                for dx in 0..2u32 {
+                    let sx = (x * 2 + dx).min(width - 1);
+                    let sy = (y * 2 + dy).min(height - 1);
+                    let index = ((sy * width + sx) * 4) as usize;
+                    let alpha = f32::from(rgba[index + 3]) / 255.0;
+
+                    acc[0] += f32::from(rgba[index]) * alpha;
+                    acc[1] += f32::from(rgba[index + 1]) * alpha;
+                    acc[2] += f32::from(rgba[index + 2]) * alpha;
+                    acc[3] += alpha;
+                    samples += 1.0;
+                }
+            }
+
+            if samples == 0.0 || acc[3] <= f32::EPSILON {
+                continue;
+            }
+
+            let index = ((y * next_width + x) * 4) as usize;
+            let alpha = acc[3] / samples;
+
+            out[index] = (acc[0] / acc[3]).round().clamp(0.0, 255.0) as u8;
+            out[index + 1] = (acc[1] / acc[3]).round().clamp(0.0, 255.0) as u8;
+            out[index + 2] = (acc[2] / acc[3]).round().clamp(0.0, 255.0) as u8;
+            out[index + 3] = (alpha * 255.0).round().clamp(0.0, 255.0) as u8;
+        }
+    }
+
+    (next_width, next_height, out)
+}
